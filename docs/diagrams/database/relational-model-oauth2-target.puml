@startuml
title Modèle relationnel cible OAuth2 / OpenID Connect

hide circle
skinparam shadowing false
skinparam roundcorner 10

entity "application" as application {

    * id_application : UUID <<PK>>

    --

    code : VARCHAR(50) <<UQ>>
    description : VARCHAR(255)
}

entity "oauth2_client" as oauth2_client {

    * id_oauth2_client : UUID <<PK>>

    --

    application_id : UUID <<FK>>

    client_id : VARCHAR(100) <<UQ>>
    client_secret_hash : VARCHAR(255)

    enabled : BOOLEAN

    access_token_ttl : INTEGER
    refresh_token_ttl : INTEGER

    require_pkce : BOOLEAN
}

entity "oauth2_scope" as oauth2_scope {

    * id_oauth2_scope : UUID <<PK>>

    --

    application_id : UUID <<FK>>

    code : VARCHAR(100)
    description : VARCHAR(255)
}

entity "oauth2_client_scope" as oauth2_client_scope {

    * oauth2_client_id : UUID <<PK, FK>>
    * oauth2_scope_id  : UUID <<PK, FK>>
}

entity "oauth2_authorization" as oauth2_authorization {

    * id_oauth2_authorization : UUID <<PK>>

    --

    oauth2_client_id : UUID <<FK>>

    principal_name : VARCHAR(255)

    authorization_grant_type : VARCHAR(100)

    state : VARCHAR(500)

    authorized_at : TIMESTAMP
}

entity "oauth2_authorization_scope" as oauth2_authorization_scope {

    * oauth2_authorization_id : UUID <<PK, FK>>
    * oauth2_scope_id         : UUID <<PK, FK>>
}

entity "oauth2_access_token" as oauth2_access_token {

    * id_oauth2_access_token : UUID <<PK>>

    --

    authorization_id : UUID <<FK>>

    token_value : VARCHAR(4000)

    issued_at : TIMESTAMP
    expires_at : TIMESTAMP

    revoked : BOOLEAN
}

entity "oauth2_refresh_token" as oauth2_refresh_token {

    * id_oauth2_refresh_token : UUID <<PK>>

    --

    authorization_id : UUID <<FK>>

    token_value : VARCHAR(4000)

    issued_at : TIMESTAMP
    expires_at : TIMESTAMP

    revoked : BOOLEAN
}

entity "oauth2_consent" as oauth2_consent {

    * id_oauth2_consent : UUID <<PK>>

    --

    oauth2_client_id : UUID <<FK>>

    principal_name : VARCHAR(255)

    consented_at : TIMESTAMP
}

entity "oauth2_consent_scope" as oauth2_consent_scope {

    * oauth2_consent_id : UUID <<PK, FK>>
    * oauth2_scope_id   : UUID <<PK, FK>>
}

application ||--o{ oauth2_client

application ||--o{ oauth2_scope

oauth2_client ||--o{ oauth2_client_scope
oauth2_scope ||--o{ oauth2_client_scope

oauth2_client ||--o{ oauth2_authorization

oauth2_authorization ||--o{ oauth2_authorization_scope
oauth2_scope ||--o{ oauth2_authorization_scope

oauth2_authorization ||--o{ oauth2_access_token
oauth2_authorization ||--o{ oauth2_refresh_token

oauth2_client ||--o{ oauth2_consent
oauth2_consent ||--o{ oauth2_consent_scope
oauth2_scope ||--o{ oauth2_consent_scope

@enduml