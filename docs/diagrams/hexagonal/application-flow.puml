@startuml
title Flux d'une requête dans l'architecture hexagonale

skinparam shadowing false
skinparam roundcorner 10

actor Client

rectangle "auth-server-web" {

    component "Controller REST" as Controller
}

rectangle "auth-server-application" {

    component "Application Service" as Service
}

rectangle "auth-server-core" {

    component "Use Case" as UseCase

    interface "Repository Port" as RepositoryPort
    interface "Security Port" as SecurityPort
}

rectangle "auth-server-persistence" {

    component "Repository Adapter" as RepositoryAdapter

    database "PostgreSQL" as PostgreSQL
}

rectangle "auth-server-security" {

    component "Security Adapter" as SecurityAdapter
}

Client --> Controller : HTTP Request

Controller --> Service : appel applicatif

Service --> UseCase : exécute

UseCase --> RepositoryPort : accès données
UseCase --> SecurityPort : services de sécurité

RepositoryPort --> RepositoryAdapter : implémentation
SecurityPort --> SecurityAdapter : implémentation

RepositoryAdapter --> PostgreSQL : JPA / SQL

@enduml
